[Unit]
Description=Server OS privileged helper (root, read-only Phase 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Group serveros (not root): the helper socket is created root:serveros
# 0660 so the unprivileged API service user can dial it. root:root 0600
# would lock the API out (helper then reports healthy, API reports down).
Group=serveros
Environment=HELPER_SOCKET=/run/serveros/helper.sock
ExecStart=/usr/bin/node /opt/server-os/backend-dist/helper.js
Restart=always
RestartSec=3
# /run is tmpfs: without this the socket dir vanishes on reboot and the
# helper crash-loops on ENOENT at boot (API then reports helper down).
RuntimeDirectory=serveros
RuntimeDirectoryMode=0755
# Phase 1 exposes GET-only discovery; socket perms (0660) are set by the
# process itself after bind. UMask as defence in depth.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
